# Allow the arcade to be embedded on Google Sites.
# Do not add X-Frame-Options or a restrictive frame-ancestors policy here.

# Derived previews use source-content/recipe hashes in their filenames.
/assets/covers/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

# Isolated game frames have an opaque origin. Ruffle fetches its WASM
# from this directory and needs CORS even when the arcade uses this host.
/vendor/*
  Access-Control-Allow-Origin: *

/library-source/*
  Access-Control-Allow-Origin: *

/games/backrooms3d/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/player-compat.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/catalog.js
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/ads-config.js
  Cache-Control: public, max-age=0, must-revalidate

/ads.js
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/brand.css
  Cache-Control: public, max-age=0, must-revalidate

/embed-guide.css
  Cache-Control: public, max-age=0, must-revalidate

/outputs/turbogames-brand-kit/TurboGames-brand-kit.zip
  Content-Disposition: attachment; filename="TurboGames-brand-kit.zip"
  Cache-Control: public, max-age=0, must-revalidate

/google-sites.html
  Cache-Control: public, max-age=0, must-revalidate
